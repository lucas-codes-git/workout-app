# Local host binding. Keep 127.0.0.1 for computer-only access.
# Set this to the computer's private LAN IP only when using the app from your phone.
HOST_BIND_IP=127.0.0.1

# Database settings. Use a strong password for local data protection.
POSTGRES_USER=workout_app
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=workout_db
DATABASE_URL=postgresql://workout_app:replace-with-a-long-random-password@postgres:5432/workout_db

# HTTP Basic Auth for the private app gateway.
APP_USERNAME=owner
APP_PASSWORD=replace-with-a-long-random-password